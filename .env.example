# Kopier denne filen til .env og lim inn det permanente bot-tokenet.
# .env skal ALDRI deles eller pushes til GitHub.
META_ACCESS_TOKEN=lim_inn_tokenet_her
IG_USER_ID=17841450044968553
GRAPH_API_VERSION=v26.0

# Supabase: Project Settings -> API. Secret key gir full tilgang og skal bare ligge i .env / GitHub Secrets.
SUPABASE_URL=https://ditt-prosjekt.supabase.co
SUPABASE_SECRET_KEY=lim_inn_secret_key_her

# YouTube (OAuth, kun lesetilgang). Fylles automatisk av youtube_auth.py fra secrets/.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
